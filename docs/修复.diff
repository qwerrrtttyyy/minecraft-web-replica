+  /**
+   * 脊线噪声：把 1-|n| 平方后叠加，输出 0~1。
+   * 高值形成连续的山脊 / 河道轮廓，比普通 fBm 更像真实地貌。
+   */
+  ridged2(x: number, y: number, octaves: number, lacunarity = 2, gain = 0.5): number {
+    let sum = 0;
+    let amp = 1;
+    let freq = 1;
+    let norm = 0;
+    for (let i = 0; i < octaves; i++) {
+      const r = 1 - Math.abs(this.noise2(x * freq, y * freq));
+      sum += r * r * amp;
+      norm += amp;
+      amp *= gain;
+      freq *= lacunarity;
+    }
+    return sum / norm;
+  }
+
+  /** 3D 分形叠加（洞穴 / 矿脉等体积特征） */
+  fbm3(x: number, y: number, z: number, octaves: number, lacunarity = 2, gain = 0.5): number {
+    let sum = 0;
+    let amp = 1;
+    let freq = 1;
+    let norm = 0;
+    for (let i = 0; i < octaves; i++) {
+      sum += this.noise3(x * freq, y * freq, z * freq) * amp;
+      norm += amp;
+      amp *= gain;
+      freq *= lacunarity;
+    }
+    return sum / norm;
+  }
