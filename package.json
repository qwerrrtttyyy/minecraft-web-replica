{
  "name": "minecraft-ts",
  "private": true,
  "version": "1.5.0",
  "type": "module",
  "description": "TypeScript + three.js 的 Minecraft 基础复刻（体素引擎）· 服务化架构",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check:version": "node scripts/check-version.mjs",
    "lint": "biome lint",
    "lint:fix": "biome lint --write",
    "lint:eslint": "eslint src --max-warnings 0",
    "check": "biome check",
    "check:fix": "biome check --write",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test:snapshot": "node scripts/build-test-snapshot.mjs",
    "test:logic": "node test/logic-check.cjs && node test/terrain-check.cjs",
    "test:mesher": "node test/mesher-check.cjs",
    "test:services": "node test/services-check.cjs",
    "test:diagnostics": "node test/diagnostics-check.cjs",
    "test:worker-pool": "node test/worker-pool-check.cjs",
    "test:unstuck": "node test/unstuck-check.cjs",
    "test:edits": "node test/world-edits-check.cjs",
    "test:terrain-system": "node test/terrain-system-check.cjs",
    "test:feel": "node test/feel-check.cjs",
    "test:botany": "node test/botany-check.cjs",
    "test:botany-rules": "node test/botany-rules-check.cjs",
    "test:plant-energy": "node test/plant-energy-check.cjs",
    "test:crafting": "node test/crafting-check.cjs",
    "test:smoke": "node test/survival-smoke.mjs",
    "test:options": "node test/options-check.mjs",
    "test:smoke:xvfb": "xvfb-run -a -s \"-screen 0 1280x760x24\" env MC_HEADLESS=0 MC_GL=desktop node test/survival-smoke.mjs",
    "verify": "npm run check:version && npm run test:permtable && npm run wasm:check && npm run lint && npm run typecheck && npm run build && npm run test:snapshot && npm run test:wasm && npm run test:plugin-v2 && npm run test:plugin-carrier && npm run test:review-fixes && npm run test:logic && npm run test:light && npm run test:mesher && npm run test:services && npm run test:diagnostics && npm run test:worker-pool && npm run test:unstuck && npm run test:edits && npm run test:terrain-system && npm run test:feel && npm run test:botany && npm run test:plant-energy && npm run test:botany-rules && npm run test:crafting && npm run test:smoke && npm run test:options && npm run test:visual",
    "test:light": "node test/light-check.cjs",
    "test:visual": "node test/visual-check.mjs",
    "build:wasm": "node scripts/build-wasm.mjs",
    "wasm:check": "node scripts/build-wasm.mjs --check",
    "test:wasm": "node test/wasm-check.cjs",
    "test:plugin-v2": "node test/plugin-v2-check.cjs",
    "test:plugin-carrier": "node test/plugin-carrier-check.cjs",
    "test:review-fixes": "node test/review-fixes-check.cjs",
    "build:plugin-fixtures": "node scripts/build-plugin-fixtures.mjs",
    "test:permtable": "node test/permission-table-check.cjs"
  },
  "dependencies": {
    "three": "0.170.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/three": "0.170.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "eslint": "^9.39.5",
    "jsdom": "^25.0.1",
    "puppeteer-core": "^23.11.1",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-pwa": "0.20.5",
    "vite-plugin-singlefile": "2.0.3"
  }
}
